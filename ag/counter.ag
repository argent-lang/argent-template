import "std::core";

state CounterState {
    int count;
}

actor Counter owns CounterState {
    entry bump(int delta) emits next: Counter {
        require(delta > 0);

        CounterState updated = {
            count: count + delta,
        };

        require(next.value == self.value);
        become next <- Counter(updated);
    }
}

app Demo {
    actor Counter;
}
